# Shield Safe Bank - Environment variables for PXXL deployment
# Copy this file to .env and fill in your values. Never commit .env.

# Supabase Postgres connection string (Session pooler or Transaction pooler)
DATABASE_URL=

# Supabase project URL
SUPABASE_URL=

# Supabase service role key (server-side only, never in frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Session secret for legacy HMAC tokens (generate a random string)
SESSION_SECRET=

# Allowed CORS origins (comma-separated, no spaces)
ALLOWED_ORIGINS=

# Port for the Express server
PORT=4000

# Resend API key for email (password reset, verification)
RESEND_API_KEY=

# Base URL of the frontend (for reset password links)
APP_URL=